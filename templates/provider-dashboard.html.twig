{% import "components/form/fields_macros.html.twig" as fields %}

<div class="mb-4">
    {% if errors.global is defined %}
        <div class="alert alert-danger">
            <i class="ti ti-alert-circle me-2"></i>
            {{ errors.global }}
        </div>
    {% else %}

        {# ---------------------------------------------------------------- #}
        {# Appareils #}
        {# ---------------------------------------------------------------- #}
        {{ fields.smallTitle(__('Appareils', 'backupgestion')) }}
        {% if errors.devices is defined %}
            <div class="alert alert-warning">
                <i class="ti ti-alert-triangle me-2"></i>
                {{ errors.devices }}
            </div>
        {% elseif devices is not null %}
            {% if devices|length %}
                <table class="table table-sm">
                    <thead>
                        <tr class="bg-blue">
                            <th class="text-white fw-bold">{{ __('Nom') }}</th>
                            <th class="text-white fw-bold">{{ __('Statut', 'backupgestion') }}</th>
                            <th class="text-white fw-bold">{{ __('Plateforme', 'backupgestion') }}</th>
                            <th class="text-white fw-bold">{{ __('Tenant', 'backupgestion') }}</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for device in devices %}
                        <tr>
                            <td>{{ device.name }}</td>
                            <td>
                                {% if device.online %}
                                    <span class="badge bg-success">{{ __('En ligne', 'backupgestion') }}</span>
                                {% else %}
                                    <span class="badge bg-secondary-lt">{{ __('Hors ligne', 'backupgestion') }}</span>
                                {% endif %}
                                {% if not device.enabled %}
                                    <span class="badge bg-warning">{{ __('Désactivé', 'backupgestion') }}</span>
                                {% endif %}
                            </td>
                            <td>{{ device.platform }}</td>
                            <td>{{ device.tenant }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            {% else %}
                <div class="alert alert-info"><i class="ti ti-info-circle me-2"></i>{{ __('Aucun appareil trouvé.', 'backupgestion') }}</div>
            {% endif %}
        {% endif %}

        {# ---------------------------------------------------------------- #}
        {# Plans de sauvegarde #}
        {# ---------------------------------------------------------------- #}
        {{ fields.smallTitle(__('Plans de sauvegarde', 'backupgestion')) }}
        {% if errors.plans is defined %}
            <div class="alert alert-warning">
                <i class="ti ti-alert-triangle me-2"></i>
                {{ errors.plans }}
            </div>
        {% elseif plans is not null %}
            {% if plans|length %}
                <table class="table table-sm">
                    <thead>
                        <tr class="bg-blue">
                            <th class="text-white fw-bold">{{ __('Nom') }}</th>
                            <th class="text-white fw-bold">{{ __('Type', 'backupgestion') }}</th>
                            <th class="text-white fw-bold">{{ __('Statut', 'backupgestion') }}</th>
                            <th class="text-white fw-bold">{{ __('Dernière modification', 'backupgestion') }}</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for plan in plans %}
                        <tr>
                            <td>{{ plan.name }}</td>
                            <td>{{ plan.type }}</td>
                            <td>
                                {% if plan.enabled %}
                                    <span class="badge bg-success">{{ __('Actif') }}</span>
                                {% else %}
                                    <span class="badge bg-secondary-lt">{{ __('Inactif') }}</span>
                                {% endif %}
                            </td>
                            <td>{{ plan.updated_at }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            {% else %}
                <div class="alert alert-info"><i class="ti ti-info-circle me-2"></i>{{ __('Aucun plan de sauvegarde trouvé.', 'backupgestion') }}</div>
            {% endif %}
        {% endif %}

        {# ---------------------------------------------------------------- #}
        {# Statistiques #}
        {# ---------------------------------------------------------------- #}
        {{ fields.smallTitle(__('Statistiques d\'usage', 'backupgestion')) }}
        {% if errors.stats is defined %}
            <div class="alert alert-warning">
                <i class="ti ti-alert-triangle me-2"></i>
                {{ errors.stats }}
            </div>
        {% elseif stats is not null %}
            {% if stats|length %}
                <table class="table table-sm">
                    <thead>
                        <tr class="bg-blue">
                            <th class="text-white fw-bold">{{ __('Tenant', 'backupgestion') }}</th>
                            <th class="text-white fw-bold">{{ __('Mesure', 'backupgestion') }}</th>
                            <th class="text-white fw-bold">{{ __('Édition', 'backupgestion') }}</th>
                            <th class="text-white fw-bold">{{ __('Volume (Go)', 'backupgestion') }}</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for stat in stats %}
                        {# Converti en Go puis formaté avec le séparateur des milliers du compte
                           utilisateur courant (Html::formatNumber lit $_SESSION['glpinumber_format'],
                           réglable dans Préférences > Personnalisation) — retour de Luc. Le tenant
                           associé est affiché pour permettre l'identification (facturation…). Seules
                           les lignes à usage réel (valeur > 0) sont remontées par listBackupStats(). #}
                        <tr>
                            <td>{{ stat.tenant_name ?: stat.tenant_id }}</td>
                            <td>{{ stat.name }}</td>
                            <td>{% if stat.edition %}<span class="badge bg-blue-lt">{{ stat.edition }}</span>{% endif %}</td>
                            <td>{{ call('Html::formatNumber', [(stat.value ?: 0) / 1073741824, false, 2]) }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            {% else %}
                <div class="alert alert-info"><i class="ti ti-info-circle me-2"></i>{{ __('Aucune statistique disponible.', 'backupgestion') }}</div>
            {% endif %}
        {% endif %}

    {% endif %}
</div>
