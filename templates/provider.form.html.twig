{% extends "generic_show_form.html.twig" %}
{% import "components/form/fields_macros.html.twig" as fields %}

{% block more_fields %}

    {# Nom, entité, sous-entités et commentaire sont des champs CommonDBTM standards
       déjà rendus par generic_show_form.html.twig. #}

    <input type="hidden" name="provider_type" value="acronis" />

    <div class="mb-3 row">
        <label class="col-xxl-4 col-form-label">{{ __('Type de provider', 'backupgestion') }}</label>
        <div class="col-xxl-8">
            <div class="form-control-plaintext">{{ providerLabel }}</div>
        </div>
    </div>

    {{ fields.smallTitle(__('Identifiants API (chiffrés localement, jamais dans Accounts)', 'backupgestion')) }}

    {% for key, def in credentialFields %}
        <div class="mb-3 row">
            <label class="col-xxl-4 col-form-label">
                {{ def.label }}{% if def.required %} *{% endif %}
            </label>
            <div class="col-xxl-8">
                {% if def.type == 'password' %}
                    {# Le vrai secret n'est jamais renvoyé en clair au navigateur, même en
                       édition (comme le mot de passe DNSManager) — champ toujours vide.
                       Pas de "readonly" ici (retour de Luc : ça grise le champ et laisse
                       croire qu'il n'est pas éditable) — autocomplete/data-*-ignore
                       suffisent à dissuader Chrome/Firefox de proposer un identifiant
                       enregistré sur ce champ vide. #}
                    <input type="password"
                           name="cred_{{ key }}"
                           class="form-control"
                           autocomplete="new-password"
                           data-lpignore="true"
                           data-1p-ignore
                           placeholder="{{ hasCredentials[key] is defined ? __('Déjà renseigné — laisser vide pour ne pas modifier', 'backupgestion') : (def.placeholder ?? '') }}" />
                {% else %}
                    {# Non sensible (identifiant, URL) — pré-rempli avec la vraie valeur
                       déchiffrée en édition, comme DNSManager. #}
                    <input type="text"
                           name="cred_{{ key }}"
                           class="form-control"
                           autocomplete="off"
                           value="{{ prefillValues[key] ?? '' }}"
                           placeholder="{{ def.placeholder ?? '' }}" />
                {% endif %}
            </div>
        </div>
    {% endfor %}

    {% if item.fields['id'] %}
        <div class="col-12 mb-3 d-flex gap-2 flex-wrap align-items-center">
            <button type="button" id="bg-btn-test" class="btn btn-primary" data-id="{{ item.fields['id'] }}" data-url="{{ webdir }}/front/provider.form.php">
                <i class="ti ti-plug me-1"></i>{{ __('Tester la connexion', 'backupgestion') }}
            </button>
            <span id="bg-test-result"></span>
        </div>
        <div class="col-12 mb-3 d-flex gap-2 flex-wrap align-items-center">
            <button type="button" id="bg-btn-discover" class="btn btn-secondary" data-id="{{ item.fields['id'] }}" data-url="{{ webdir }}/front/provider.form.php">
                <i class="ti ti-hierarchy-2 me-1"></i>{{ __('Découvrir les tenants enfants', 'backupgestion') }}
            </button>
            <span id="bg-discover-result"></span>
        </div>
        <script>
        (function() {
            var csrfMeta = document.querySelector("meta[property='glpi:csrf_token']");
            var csrf = csrfMeta ? csrfMeta.content : '';

            function postAction(btn, resultEl, body, onSuccess) {
                btn.disabled = true;
                resultEl.innerHTML = "<span class='badge bg-info'>" + {{ __('En cours...', 'backupgestion')|json_encode|raw }} + "</span>";
                fetch(btn.dataset.url, {
                    method: 'POST',
                    headers: {'Content-Type': 'application/x-www-form-urlencoded', 'X-Glpi-Csrf-Token': csrf, 'X-Requested-With': 'XMLHttpRequest'},
                    body: new URLSearchParams(body)
                })
                .then(function(r) { return r.json(); })
                .then(function(d) {
                    btn.disabled = false;
                    if (d.success) {
                        onSuccess(d, resultEl);
                    } else {
                        resultEl.innerHTML = "<span class='badge bg-danger'>" + (d.message || {{ __('Échec', 'backupgestion')|json_encode|raw }}) + "</span>";
                    }
                })
                .catch(function() {
                    btn.disabled = false;
                    resultEl.innerHTML = "<span class='badge bg-danger'>" + {{ __('Erreur réseau', 'backupgestion')|json_encode|raw }} + "</span>";
                });
            }

            var testBtn = document.getElementById('bg-btn-test');
            if (testBtn) {
                testBtn.addEventListener('click', function() {
                    postAction(testBtn, document.getElementById('bg-test-result'),
                        {test_connection: '1', id: testBtn.dataset.id},
                        function(d, el) {
                            el.innerHTML = "<span class='badge bg-success'>" + {{ __('Connexion réussie', 'backupgestion')|json_encode|raw }} + "</span>";
                        }
                    );
                });
            }

            var discoverBtn = document.getElementById('bg-btn-discover');
            if (discoverBtn) {
                discoverBtn.addEventListener('click', function() {
                    postAction(discoverBtn, document.getElementById('bg-discover-result'),
                        {discover_children: '1', id: discoverBtn.dataset.id},
                        function(d, el) {
                            var msg = (d.found || 0) + ' ' + {{ __('trouvé(s)', 'backupgestion')|json_encode|raw }}
                                + ' — ' + (d.created || 0) + ' ' + {{ __('créé(s)', 'backupgestion')|json_encode|raw }}
                                + ', ' + (d.updated || 0) + ' ' + {{ __('mis à jour', 'backupgestion')|json_encode|raw }};
                            el.innerHTML = "<span class='badge bg-success'>" + msg + "</span>";
                            if ((d.created || 0) > 0) {
                                setTimeout(function() { window.location.reload(); }, 1500);
                            }
                        }
                    );
                });
            }
        })();
        </script>
    {% else %}
        <div class="alert alert-info mt-2">
            <i class="ti ti-info-circle me-2"></i>
            {{ __("Le test de connexion sera disponible après la première sauvegarde de la fiche.", 'backupgestion') }}
        </div>
    {% endif %}

    {# Les "Valeurs par défaut" (empreinte, type, statut, utilisateur/groupe...) sont
       désormais dans leur propre onglet "Valeurs par défaut" (clarté de l'interface,
       retour de Luc) — voir ProviderAccountsDefaults. #}

    {% if accountsAvailable and item.fields['id'] %}
        {{ fields.smallTitle(__('Créer un compte utilisateur', 'backupgestion')) }}

        <div class="alert alert-info">
            <i class="ti ti-info-circle me-2"></i>
            {{ __('Création de compte utilisateur/admin/clé cryptage avec les valeurs par défaut.', 'backupgestion') }}
        </div>

        <div class="mb-3 row">
            <label class="col-xxl-4 col-form-label">{{ __('Identifiant', 'backupgestion') }}</label>
            <div class="col-xxl-8">
                <input type="text" id="bg-accounts-login" class="form-control" autocomplete="off" />
            </div>
        </div>
        <div class="mb-3 row">
            <label class="col-xxl-4 col-form-label">{{ __('Mot de passe', 'backupgestion') }}</label>
            <div class="col-xxl-8">
                <input type="password" id="bg-accounts-password" class="form-control"
                       autocomplete="new-password"
                       data-lpignore="true" data-1p-ignore />
            </div>
        </div>
        <div class="mb-3 row">
            <label class="col-xxl-4 col-form-label">{{ __('Administrateur', 'backupgestion') }}</label>
            <div class="col-xxl-8">
                <input type="checkbox" id="bg-accounts-is-admin" class="form-check-input" />
                <span class="form-text d-inline">{{ __('Force le type en Administration.', 'backupgestion') }}</span>
            </div>
        </div>
        <div class="mb-3 row">
            <label class="col-xxl-4 col-form-label">{{ __('Clé de cryptage', 'backupgestion') }}</label>
            <div class="col-xxl-8">
                <input type="checkbox" id="bg-accounts-is-cryptkey" class="form-check-input" />
                <span class="form-text d-inline">{{ __('Force le type en "Clé de chiffrement". Exclusif avec "Administrateur".', 'backupgestion') }}</span>
            </div>
        </div>
        <div class="mb-3 row">
            <label class="col-xxl-4 col-form-label">{{ __('Empreinte — clé de chiffrement', 'backupgestion') }}</label>
            <div class="col-xxl-8">
                <input type="password" id="bg-accounts-key" class="form-control"
                       autocomplete="new-password"
                       data-lpignore="true" data-1p-ignore
                       placeholder="{{ __('Laisser vide si une clé serveur ou de session est déjà disponible', 'backupgestion') }}" />
            </div>
        </div>
        <div class="col-12 mb-3 d-flex gap-2 flex-wrap align-items-center">
            <button type="button" id="bg-btn-create-accounts" class="btn btn-primary" data-id="{{ item.fields['id'] }}" data-url="{{ webdir }}/front/provider.form.php">
                <i class="ti ti-key me-1"></i>{{ __('Créer le compte', 'backupgestion') }}
            </button>
            <button type="button" id="bg-btn-forget-key" class="btn btn-outline-secondary" data-id="{{ item.fields['id'] }}" data-hash="{{ accountsHashId }}" data-url="{{ webdir }}/front/provider.form.php">
                <i class="ti ti-lock-off me-1"></i>{{ __('Oublier la clé', 'backupgestion') }}
            </button>
            <span id="bg-accounts-result"></span>
        </div>
        <script>
        (function() {
            var csrfMeta = document.querySelector("meta[property='glpi:csrf_token']");
            var csrf = csrfMeta ? csrfMeta.content : '';

            function postForm(btn, resultEl, body, onSuccess) {
                btn.disabled = true;
                resultEl.innerHTML = "<span class='badge bg-info'>" + {{ __('En cours...', 'backupgestion')|json_encode|raw }} + "</span>";
                fetch(btn.dataset.url, {
                    method: 'POST',
                    headers: {'Content-Type': 'application/x-www-form-urlencoded', 'X-Glpi-Csrf-Token': csrf, 'X-Requested-With': 'XMLHttpRequest'},
                    body: new URLSearchParams(body)
                })
                .then(function(r) { return r.json(); })
                .then(function(d) {
                    btn.disabled = false;
                    if (d.success) {
                        onSuccess(d, resultEl);
                    } else {
                        resultEl.innerHTML = "<span class='badge bg-danger'>" + (d.message || {{ __('Échec', 'backupgestion')|json_encode|raw }}) + "</span>";
                    }
                })
                .catch(function() {
                    btn.disabled = false;
                    resultEl.innerHTML = "<span class='badge bg-danger'>" + {{ __('Erreur réseau', 'backupgestion')|json_encode|raw }} + "</span>";
                });
            }

            var isAdminBox    = document.getElementById('bg-accounts-is-admin');
            var isCryptkeyBox = document.getElementById('bg-accounts-is-cryptkey');
            var loginInput    = document.getElementById('bg-accounts-login');

            // Une "Clé de cryptage" n'a pas de notion d'identifiant : on vide et on
            // verrouille le champ tant que la case est cochée, pour éviter qu'une saisie
            // oubliée ne soit enregistrée sur ce type de compte (retour de Luc).
            function syncLoginField() {
                if (loginInput) {
                    if (isCryptkeyBox.checked) {
                        loginInput.value = '';
                        loginInput.disabled = true;
                    } else {
                        loginInput.disabled = false;
                    }
                }
            }

            if (isAdminBox && isCryptkeyBox) {
                isAdminBox.addEventListener('change', function() {
                    if (isAdminBox.checked) { isCryptkeyBox.checked = false; }
                    syncLoginField();
                });
                isCryptkeyBox.addEventListener('change', function() {
                    if (isCryptkeyBox.checked) { isAdminBox.checked = false; }
                    syncLoginField();
                });
            }

            var createBtn = document.getElementById('bg-btn-create-accounts');
            if (createBtn) {
                createBtn.addEventListener('click', function() {
                    var resultEl = document.getElementById('bg-accounts-result');
                    postForm(createBtn, resultEl, {
                        create_accounts_admin: '1',
                        id: createBtn.dataset.id,
                        accounts_login: loginInput.value,
                        accounts_password: document.getElementById('bg-accounts-password').value,
                        accounts_is_admin: isAdminBox.checked ? '1' : '',
                        accounts_is_cryptkey: isCryptkeyBox.checked ? '1' : '',
                        accounts_key: document.getElementById('bg-accounts-key').value
                    }, function(d, el) {
                        el.innerHTML = "<span class='badge bg-success'>" + {{ __('Compte créé et lié', 'backupgestion')|json_encode|raw }} + " (#" + d.accounts_id + ")</span>";
                        loginInput.disabled = false;
                        loginInput.value = '';
                        document.getElementById('bg-accounts-password').value = '';
                        isAdminBox.checked = false;
                        isCryptkeyBox.checked = false;
                        document.getElementById('bg-accounts-key').value = '';
                    });
                });
            }

            var forgetBtn = document.getElementById('bg-btn-forget-key');
            if (forgetBtn) {
                forgetBtn.addEventListener('click', function() {
                    var resultEl = document.getElementById('bg-accounts-result');
                    postForm(forgetBtn, resultEl, {
                        forget_accounts_key: '1',
                        id: forgetBtn.dataset.id,
                        accounts_hash_id: forgetBtn.dataset.hash
                    }, function(d, el) {
                        el.innerHTML = "<span class='badge bg-success'>" + {{ __('Clé oubliée', 'backupgestion')|json_encode|raw }} + "</span>";
                    });
                });
            }
        })();
        </script>
    {% elseif accountsAvailable %}
        <div class="alert alert-info mt-2">
            <i class="ti ti-info-circle me-2"></i>
            {{ __('La création du compte admin sera possible après la première sauvegarde de la fiche.', 'backupgestion') }}
        </div>
    {% endif %}

    {% if children|length %}
        {{ fields.smallTitle(__('Sous-tenants rattachés', 'backupgestion')) }}
        <table class="table table-sm">
            <thead><tr><th>{{ __('Nom') }}</th><th>{{ __('Entité') }}</th><th></th></tr></thead>
            <tbody>
            {% for child in children %}
                <tr>
                    <td><a href="{{ webdir }}/front/provider.form.php?id={{ child.id }}">{{ child.name }}</a></td>
                    <td>
                        {# Widget natif GLPI (Dropdown::show), recherche intégrée à la liste
                           déroulante comme le combo "Utilisateur concerné" (retour de Luc) —
                           reflète l'entité actuelle par défaut, ses propres boutons ("i"
                           commentaire, "+" ajout d'entité) restent utilisables normalement
                           puisque "Déplacer" a maintenant sa propre colonne, sans jamais les
                           recouvrir (retour de Luc — un clic mal placé ouvrait la gestion
                           des entités). #}
                        <span class="bg-quickmove-entity-wrap" data-child-id="{{ child.id }}" data-select-name="quickmove_entity_{{ child.id }}" title="{{ child.entity_name }}">
                            {{ child.quickmove_widget|raw }}
                        </span>
                    </td>
                    <td class="d-flex flex-wrap gap-2 align-items-center">
                        <button type="button" class="btn btn-sm btn-outline-secondary bg-btn-quickmove" data-child-id="{{ child.id }}" data-url="{{ webdir }}/front/provider.form.php">
                            {{ __('Déplacer', 'backupgestion') }}
                        </button>
                        <span class="bg-quickmove-result" data-child-id="{{ child.id }}"></span>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
        <script>
        (function() {
            var csrfMeta = document.querySelector("meta[property='glpi:csrf_token']");
            var csrf = csrfMeta ? csrfMeta.content : '';

            function doMove(btn, childId, extra) {
                var select   = document.querySelector('select[name="quickmove_entity_' + childId + '"]');
                var resultEl = document.querySelector('.bg-quickmove-result[data-child-id="' + childId + '"]');
                var body = Object.assign({quick_move_entity: '1', id: childId, entities_id: select.value}, extra || {});
                btn.disabled = true;
                resultEl.innerHTML = "<span class='badge bg-info'>" + {{ __('En cours...', 'backupgestion')|json_encode|raw }} + "</span>";
                fetch(btn.dataset.url, {
                    method: 'POST',
                    headers: {'Content-Type': 'application/x-www-form-urlencoded', 'X-Glpi-Csrf-Token': csrf, 'X-Requested-With': 'XMLHttpRequest'},
                    body: new URLSearchParams(body)
                })
                .then(function(r) { return r.json(); })
                .then(function(d) {
                    btn.disabled = false;
                    if (d.success) {
                        resultEl.innerHTML = "<span class='badge bg-success'>" + {{ __('Déplacé', 'backupgestion')|json_encode|raw }} + "</span>";
                        setTimeout(function() { window.location.reload(); }, 1000);
                    } else if (d.needs_hash_selection) {
                        // Cas 2 (retour de Luc) : l'empreinte actuelle du provider n'est pas
                        // valide dans la destination — demande d'en choisir une autre + sa clé
                        // avant de confirmer le déplacement.
                        var opts = '<option value="0">-- {{ __('Choisir une empreinte', 'backupgestion') }} --</option>';
                        Object.keys(d.hashes || {}).forEach(function(hid) {
                            opts += '<option value="' + hid + '">' + d.hashes[hid] + '</option>';
                        });
                        resultEl.innerHTML =
                            "<div class='alert alert-warning p-2 mb-1'>" + (d.message || '') + "</div>" +
                            "<select class='form-select form-select-sm mb-1 bg-quickmove-newhash'>" + opts + "</select>" +
                            "<input type='password' class='form-control form-control-sm mb-1 bg-quickmove-newkey' placeholder='" +
                            {{ __('Clé de l\'empreinte', 'backupgestion')|json_encode|raw }} + "' autocomplete='new-password' />" +
                            "<button type='button' class='btn btn-sm btn-primary bg-btn-quickmove-confirm'>" +
                            {{ __('Confirmer le déplacement', 'backupgestion')|json_encode|raw }} + "</button>";
                        resultEl.querySelector('.bg-btn-quickmove-confirm').addEventListener('click', function() {
                            var newHashId = resultEl.querySelector('.bg-quickmove-newhash').value;
                            var newKey    = resultEl.querySelector('.bg-quickmove-newkey').value;
                            doMove(btn, childId, {accounts_hash_id: newHashId, accounts_key: newKey});
                        });
                    } else {
                        resultEl.innerHTML = "<span class='badge bg-danger'>" + (d.message || {{ __('Échec', 'backupgestion')|json_encode|raw }}) + "</span>";
                    }
                })
                .catch(function() {
                    btn.disabled = false;
                    resultEl.innerHTML = "<span class='badge bg-danger'>" + {{ __('Erreur réseau', 'backupgestion')|json_encode|raw }} + "</span>";
                });
            }

            document.querySelectorAll('.bg-btn-quickmove').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    doMove(btn, btn.dataset.childId, {});
                });
            });
        })();
        </script>
    {% endif %}

{% endblock more_fields %}
