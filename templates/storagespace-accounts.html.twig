{% import "components/form/fields_macros.html.twig" as fields %}

<div class="mb-4">

    {% if canUpdate %}
        {{ fields.smallTitle(__('Lier un compte existant', 'backupgestion')) }}

        <div class="alert alert-info">
            <i class="ti ti-info-circle me-2"></i>
            {{ __('Relie un compte déjà créé dans Accounts (identifiant de connexion, compte administrateur, clé de chiffrement…) à cet espace de stockage. Un même compte peut être partagé entre plusieurs éléments — le type de compte est celui défini dans Accounts.', 'backupgestion') }}
        </div>

        {% if availableAccounts|length == 0 %}
            <div class="alert alert-warning">
                <i class="ti ti-alert-triangle me-2"></i>
                {{ __('Aucun compte Accounts visible pour cette entité (ou ses entités parentes récursives) — la liste ci-dessous est donc vide. Créez-en un avec le bouton "+", ou vérifiez qu\'un compte existant est bien rattaché à la bonne entité côté Accounts.', 'backupgestion') }}
            </div>
        {% endif %}

        <div class="mb-3 row">
            <label class="col-xxl-4 col-form-label">{{ __('Compte Accounts', 'backupgestion') }}</label>
            <div class="col-xxl-8 d-flex align-items-center gap-1" id="bg-storageaccount-picker">
                <div class="flex-grow-1">{{ accountPicker|raw }}</div>
                {% if accountInfoIcon %}{{ accountInfoIcon|raw }}{% endif %}
                {% if addAccountIcon %}{{ addAccountIcon|raw }}{% endif %}
            </div>
        </div>
        <div class="col-12 mb-3 d-flex gap-2 flex-wrap align-items-center">
            <button type="button" id="bg-btn-link-account" class="btn btn-primary"
                    data-storage-id="{{ item.fields['id'] }}" data-url="{{ webdir }}/front/storagespace.form.php">
                <i class="ti ti-link me-1"></i>{{ __('Lier', 'backupgestion') }}
            </button>
            <span id="bg-storageaccount-link-result"></span>
        </div>

        <hr class="my-4" />
    {% endif %}

    {{ fields.smallTitle(__('Comptes liés', 'backupgestion')) }}

    {% if links|length %}
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>{{ __('Compte', 'backupgestion') }}</th>
                    <th>{{ __('Identifiant', 'backupgestion') }}</th>
                    <th>{{ __('Type', 'backupgestion') }}</th>
                    {% if canUpdate %}<th class="text-end">{{ __('Actions') }}</th>{% endif %}
                </tr>
            </thead>
            <tbody>
            {% for link in links %}
                <tr>
                    <td>
                        {% if link.account_found %}
                            {{ link.account_name }}
                        {% else %}
                            <span class="text-danger">
                                <i class="ti ti-alert-triangle me-1"></i>
                                {{ __('Compte introuvable (#%s) — probablement supprimé côté Accounts', 'backupgestion')|format(link.account_id) }}
                            </span>
                        {% endif %}
                    </td>
                    <td>{{ link.account_login }}</td>
                    <td>{% if link.account_type %}<span class="badge bg-azure-lt">{{ link.account_type }}</span>{% endif %}</td>
                    {% if canUpdate %}
                        <td class="text-end">
                            <button type="button" class="btn btn-sm btn-outline-danger bg-storageaccount-unlink"
                                    data-link-id="{{ link.id }}" data-storage-id="{{ item.fields['id'] }}"
                                    data-url="{{ webdir }}/front/storagespace.form.php">
                                <i class="ti ti-unlink"></i>
                            </button>
                        </td>
                    {% endif %}
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% else %}
        <div class="alert alert-info">
            <i class="ti ti-info-circle me-2"></i>
            {{ __('Aucun compte lié pour le moment.', 'backupgestion') }}
        </div>
    {% endif %}

    {% if canUpdate %}
        <script>
        (function() {
            var csrfMeta = document.querySelector("meta[property='glpi:csrf_token']");
            var csrf = csrfMeta ? csrfMeta.content : '';

            function postForm(btn, resultEl, body, onSuccess) {
                btn.disabled = true;
                resultEl.innerHTML = "<span class='badge bg-info'>" + {{ __('En cours...', 'backupgestion')|json_encode|raw }} + "</span>";
                fetch(btn.dataset.url, {
                    method: 'POST',
                    headers: {'Content-Type': 'application/x-www-form-urlencoded', 'X-Glpi-Csrf-Token': csrf, 'X-Requested-With': 'XMLHttpRequest'},
                    body: new URLSearchParams(body)
                })
                .then(function(r) { return r.json(); })
                .then(function(d) {
                    btn.disabled = false;
                    if (d.success) {
                        onSuccess(d, resultEl);
                    } else {
                        resultEl.innerHTML = "<span class='badge bg-danger'>" + (d.message || {{ __('Échec', 'backupgestion')|json_encode|raw }}) + "</span>";
                    }
                })
                .catch(function() {
                    btn.disabled = false;
                    resultEl.innerHTML = "<span class='badge bg-danger'>" + {{ __('Erreur réseau', 'backupgestion')|json_encode|raw }} + "</span>";
                });
            }

            var linkBtn = document.getElementById('bg-btn-link-account');
            if (linkBtn) {
                linkBtn.addEventListener('click', function() {
                    var resultEl = document.getElementById('bg-storageaccount-link-result');

                    // Le picker de compte est rendu par Dropdown::showFromArray() : on
                    // récupère sa valeur via le select natif nommé
                    // "plugin_accounts_accounts_id" dans le conteneur dédié.
                    var pickerSelect = document.querySelector('#bg-storageaccount-picker select[name="plugin_accounts_accounts_id"]');
                    var accountId = pickerSelect ? pickerSelect.value : '';

                    if (!accountId) {
                        resultEl.innerHTML = "<span class='badge bg-danger'>" + {{ __('Sélectionnez un compte.', 'backupgestion')|json_encode|raw }} + "</span>";
                        return;
                    }

                    postForm(linkBtn, resultEl, {
                        link_account: '1',
                        id: linkBtn.dataset.storageId,
                        plugin_accounts_accounts_id: accountId
                    }, function(d, el) {
                        el.innerHTML = "<span class='badge bg-success'>" + {{ __('Compte lié', 'backupgestion')|json_encode|raw }} + "</span>";
                        setTimeout(function() { window.location.reload(); }, 900);
                    });
                });
            }

            document.querySelectorAll('.bg-storageaccount-unlink').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    if (!window.confirm({{ __('Délier ce compte de cet espace de stockage ?', 'backupgestion')|json_encode|raw }})) {
                        return;
                    }
                    var resultEl = document.createElement('span');
                    postForm(btn, resultEl, {
                        unlink_account: '1',
                        id: btn.dataset.storageId,
                        link_id: btn.dataset.linkId
                    }, function() {
                        window.location.reload();
                    });
                });
            });
        })();
        </script>
    {% endif %}

</div>
